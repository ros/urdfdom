<?xml version="1.0"?>
<!-- Limit "effort" attribute is not a valid number — parsing must fail. -->
<robot name="r" version="1.0">
  <link name="l1"/>
  <link name="l2"/>
  <joint name="j1" type="fixed">
    <parent link="l1"/>
    <child link="l2"/>
    <limit effort="not_a_number" velocity="1.0"/>
  </joint>
</robot>
